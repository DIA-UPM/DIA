{% extends "layouts/base.njk" %}
{#- /buscar/?s=… — client-side search over /assets/search-index.json (generated by the build).
    Replaces WordPress' server-side search (/?s=…). Without JavaScript it shows the search form. -#}
{% from "components/search-form.njk" import themeSearch %}
{% block banner %}
<section class="ast-archive-entry-banner" data-post-type="post" data-banner-layout="layout-2" data-banner-background-type="custom">
<div class="ast-container">
<h1 id="dia-search-title">Resultados de búsqueda</h1>	</div>
</section>
{% endblock %}
{% block content %}
<div id="primary" class="content-area primary ast-blog-layout-4-grid ast-grid-3 ast-grid-md-1 ast-grid-sm-1">
<main id="main" class="site-main" data-search-results data-empty-text="{{ site.search.noResults }}">
<section class="no-results not-found">
<div class="page-content">
{{ themeSearch() }}
</div>
</section>
</main>
</div>
<script src="{{ asset('/assets/js/search.js') }}" defer></script>
{% endblock %}
