<!DOCTYPE html>
<html lang="{{ page.lang or site.lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<script>document.documentElement.classList.add('js')</script>
{% for font in site.preloadFonts %}<link rel="preload" href="{{ font }}" as="font" type="font/woff2" crossorigin>
{% endfor -%}
<title>{{ page.seo.title }}</title>
{% if page.seo.description %}<meta name="description" content="{{ page.seo.description }}">
{% endif -%}
<meta name="robots" content="{{ page.seo.robots or site.seo.robots }}">
<link rel="canonical" href="{{ absoluteUrl(page.url) }}">
{% for alt in page.alternates or [] %}<link rel="alternate" href="{{ absoluteUrl(alt.url) }}" hreflang="{{ alt.hreflang }}">
{% endfor -%}
<meta property="og:locale" content="{{ page.seo.ogLocale or site.seo.ogLocale }}">
{% if site.seo.ogLocaleAlternate %}<meta property="og:locale:alternate" content="{{ site.seo.ogLocaleAlternate }}">
{% endif -%}
<meta property="og:type" content="{{ page.seo.ogType or 'article' }}">
<meta property="og:title" content="{{ page.seo.ogTitle or page.seo.title }}">
{% if page.seo.description %}<meta property="og:description" content="{{ page.seo.description }}">
{% endif -%}
<meta property="og:url" content="{{ absoluteUrl(page.url) }}">
<meta property="og:site_name" content="{{ site.name }}">
{% if page.seo.publishedTime %}<meta property="article:published_time" content="{{ page.seo.publishedTime }}">
{% endif -%}
{% if page.seo.modifiedTime %}<meta property="article:modified_time" content="{{ page.seo.modifiedTime }}">
{% endif -%}
{% if page.seo.image %}<meta property="og:image" content="{{ absoluteUrl(page.seo.image) }}">
{% endif -%}
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="{{ site.favicon }}" sizes="32x32">
<link rel="icon" href="{{ site.favicon }}" sizes="192x192">
<link rel="apple-touch-icon" href="{{ site.favicon }}">
<meta name="msapplication-TileImage" content="{{ site.favicon }}">
{% for css in cssFiles %}<link rel="stylesheet" href="{{ css }}">
{% endfor -%}
<script type="application/ld+json">{{ structuredData(page) | safe }}</script>
</head>
<body class="{{ page.bodyClass }}">
<a class="skip-link screen-reader-text" href="#content">Ir al contenido</a>
<div class="hfeed site" id="page">
{% include "components/header.njk" %}
{% block banner %}{% endblock %}
<div id="content" class="site-content">
<div class="ast-container">
{% block content %}{% endblock %}
</div> <!-- ast-container -->
</div><!-- #content -->
{% include "components/footer.njk" %}
</div><!-- #page -->
<div id="ast-scroll-top" tabindex="0" class="ast-scroll-top-icon ast-scroll-to-top-right" data-on-devices="both" role="button" aria-label="Scroll al inicio">
<span class="screen-reader-text">Scroll al inicio</span>
</div>
<script src="{{ asset('/assets/js/site.js') }}" defer></script>
</body>
</html>
