{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cabecera de un listado (data/news-page.json, data/personnel-page.json)",
  "type": "object",
  "required": ["title", "seo"],
  "properties": {
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "descriptionHtml": { "type": "string" },
    "seo": { "type": "object", "required": ["title"], "properties": { "title": { "type": "string" } } }
  }
}
